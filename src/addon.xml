<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon
  id="plugin.program.nox.steamlauncher"
  name="Steam Launcher"
  version="1.0.0"
  provider-name="Nox"
>
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.script" library="addon.py">
    <provides>executable</provides>
  </extension>
  <extension point="kodi.addon.metadata">
    <summary lang="en">Launch Steam and wait for exit</summary>
    <description lang="en">Launch Steam and wait for exit</description>
    <platform>windx</platform> <!-- linux osx windx -->
    <language>en</language>
    <source>https://github.com/the0neWhoKnocks/plugin.program.nox.steamlauncher</source>
    <assets>
      <banner>resources/media/banner.jpg</banner>
      <fanart>resources/media/fanart.jpg</fanart>
      <icon>resources/media/icon.png</icon>
      <logo>resources/media/logo.png</logo>
      <screenshot>resources/media/screenshot-01.jpg</screenshot>
    </assets>
  </extension>
</addon>
