<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <section id="plugin.program.nox.steamlauncher">
    <category id="general" label="50050">
      <group id="1">
        <setting id="steam_path__win" type="path" label="50051" help="">
          <level>0</level>
          <default>C:\Program Files (x86)\Steam\steam.exe</default>
          <constraints>
            <writable>false</writable>
            <masking>executable</masking>
          </constraints>
          <dependencies>
            <dependency type="visible">
              <condition name="InfoBool" on="property">system.platform.windows</condition>
            </dependency>
          </dependencies>
          <control format="file" type="button">
            <heading>50051</heading>
          </control>
        </setting>
        
        <setting id="steam_bpm" label="50052" type="boolean" help="">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        
        <setting id="kodi_path__win" type="path" label="50053" help="">
          <level>0</level>
          <default>C:\Program Files\Kodi\Kodi.exe</default>
          <constraints>
            <writable>false</writable>
            <masking>executable</masking>
          </constraints>
          <dependencies>
            <dependency type="visible">
              <condition name="InfoBool" on="property">system.platform.windows</condition>
            </dependency>
          </dependencies>
          <control format="file" type="button">
            <heading>50053</heading>
          </control>
        </setting>
        
        <setting id="kodi_portable_mode" type="boolean" label="50054" help="">
					<level>0</level>
					<default>true</default>
					<control type="toggle"/>
				</setting>
      </group>
    </category>
  </section>
</settings>
